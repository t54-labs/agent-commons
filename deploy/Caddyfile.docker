:8080 {
    encode zstd gzip

    header {
        Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; font-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
    }

    @root path /
    redir @root /app/ 302

    @app_without_slash path /app
    redir @app_without_slash /app/ 308

    @immutable path /app/assets/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"

    handle_path /app/* {
        root * /srv/commons
        try_files {path} /index.html
        file_server
    }

    handle /v1/console/events {
        reverse_proxy relay:8766 {
            flush_interval -1
        }
    }

    handle /v1/* {
        reverse_proxy relay:8766
    }

    handle /health {
        reverse_proxy relay:8766
    }

    respond 404
}

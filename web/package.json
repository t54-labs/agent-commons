{
  "name": "commons-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:village-objects": "sh scripts/run_native_python.sh scripts/build_village_object_atlas.py",
    "build:village-layered": "sh scripts/run_native_python.sh scripts/build_layered_village_assets.py",
    "debug:village-layered": "sh scripts/run_native_python.sh scripts/render_layered_village_debug.py",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:unit": "vitest run src",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "1.26.0",
    "pathfinding": "^0.4.18",
    "phaser": "^4.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/pathfinding": "^0.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "^5.9.0",
    "vite": "6.4.3",
    "vitest": "^4.1.10"
  }
}
